PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/salon_db

# Business (for GST invoice - shown on printed invoice)
BUSINESS_NAME=You and I Unisex Salon
BUSINESS_ADDRESS=10th Cross, KHB Colony Surya Putra Circle Road, Chitradurga, 577501
BUSINESS_PHONE=+91 9380130076
BUSINESS_EMAIL=uandiunisexsalon@gmail.com
BUSINESS_GSTIN=99XXXXXXX9X1Z5
BUSINESS_STATE=Karnataka

# Invoice email alerts (optional — emails admin when an invoice is marked PAID, not at draft/create)
# Use a Gmail App Password if sending via Gmail: https://support.google.com/accounts/answer/185833
INVOICE_NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# For smtp.gmail.com with PORT=587, the app uses port 465 + SSL automatically (STARTTLS on 587 often fails on some networks).
# To force classic STARTTLS on 587 instead: SMTP_GMAIL_FORCE_STARTTLS=true
SMTP_USER=
SMTP_PASS=
# Optional From header (defaults to SMTP_USER or BUSINESS_EMAIL)
# SMTP_FROM=

# Attach full tax-invoice PDF to notify emails (same layout as print view). Set false to skip Puppeteer/Chromium.
INVOICE_EMAIL_ATTACH_PDF=true

# WhatsApp (optional - from Meta Developer Console)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Optional: WA_BILL_TEMPLATE=hello_world | payment_successful | invoice_bill
