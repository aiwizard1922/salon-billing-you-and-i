PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/salon_db

# Business (for GST invoice - shown on printed invoice)
BUSINESS_NAME=You and I Unisex Salon
BUSINESS_ADDRESS=10th Cross, KHB Colony Surya Putra Circle Road, Chitradurga, 577501
BUSINESS_PHONE=+91 9380130076
BUSINESS_EMAIL=uandiunisexsalon@gmail.com
BUSINESS_GSTIN=99XXXXXXX9X1Z5
BUSINESS_STATE=Karnataka

# --- Invoice email (optional: sent when an invoice is marked PAID) ---
# Values are NOT read from Git — set them in your host dashboard (e.g. Render → Environment).
#
# Recipients: one or more addresses (comma or semicolon). Who receives the alert.
INVOICE_NOTIFY_EMAIL=admin@example.com
#
# --- Production (Render Free): Resend over HTTPS (SMTP ports are blocked on free tier) ---
# 1. Sign up at https://resend.com → API Keys → create key
# 2. Domains → verify your domain (or use onboarding@resend.dev for testing only)
# 3. On Render web service, set:
#    RESEND_API_KEY=re_xxxxxxxx
#    EMAIL_FROM=You and I Salon <billing@yourdomain.com>
#    INVOICE_NOTIFY_EMAIL=uandiunisexsalon@gmail.com
# Check: GET /api/email/status → { "ready": true, "provider": "resend" }
RESEND_API_KEY=
EMAIL_FROM=
#
# --- Local dev: Gmail SMTP (omit RESEND_API_KEY to use SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Gmail App Password (2-Step Verification): https://support.google.com/accounts/answer/185833
SMTP_USER=your-salon-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# For smtp.gmail.com + PORT=587, the app prefers port 465 + SSL. Force 587: SMTP_GMAIL_FORCE_STARTTLS=true
# SMTP_FROM=You and I Salon <your-salon-gmail@gmail.com>

# Attach full tax-invoice PDF to notify emails (same layout as print view). Set false to skip Puppeteer/Chromium.
INVOICE_EMAIL_ATTACH_PDF=true

# WhatsApp (Meta Cloud API — works on Render Free via HTTPS)
# Production: set on Render web service. See docs/WHATSAPP_SETUP.md
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Invoice on create (checkbox in New Invoice). hello_world = Meta test template
WA_BILL_TEMPLATE=hello_world
# Payment receipt when invoice marked paid (must be approved in Meta)
WA_PAYMENT_TEMPLATE=payment_successful
# Optional: custom appointment template (4 body params: name, date, time, services)
# WA_APPOINTMENT_TEMPLATE=appointment_confirmed
